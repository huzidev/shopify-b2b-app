generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id                  Int                  @id @default(autoincrement())
  shopDomain          String               @unique
  accessToken         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  catalogs            Catalog[]
  companies           Company[]
  companyCustomers    CompanyCustomer[]
  collectionCustomers CollectionCustomer[]
  collections         Collection[]
  customers           Customer[]
  orders              Order[]
  priceLists          PriceList[]
  products            Product[]
  publications        Publication[]
  variants            Variant[]

  @@map("shops")
}

model Product {
  id        Int       @id @default(autoincrement())
  shopId    Int
  shopifyId String
  title     String
  handle    String?
  status    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants  Variant[]

  @@unique([shopifyId, shopId])
  @@index([shopId])
  @@map("products")
}

model Variant {
  id         Int         @id @default(autoincrement())
  shopId     Int
  shopifyId  String
  productId  Int
  sku        String?
  title      String?
  price      Decimal     @db.Decimal(10, 2)
  inventory  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopifyId, shopId])
  @@index([shopId])
  @@index([productId])
  @@map("variants")
}

model Company {
  id                Int               @id @default(autoincrement())
  shopId            Int
  shopifyId         String
  locationShopifyId String?
  contactShopifyId  String?
  name              String
  status            String            @default("Active")
  catalogs          Catalog[]
  shop              Shop              @relation(fields: [shopId], references: [id])
  customers         CompanyCustomer[]
  locations         CompanyLocation[]
  orders            Order[]

  @@unique([shopifyId, shopId])
}

model CompanyLocation {
  id        Int       @id @default(autoincrement())
  companyId Int
  shopifyId String    @unique
  name      String
  catalogs  Catalog[]
  company   Company   @relation(fields: [companyId], references: [id])
}

model CompanyCustomer {
  id                Int     @id @default(autoincrement())
  shopId            Int
  shopifyCustomerId String
  companyId         Int
  email             String?
  firstName         String?
  lastName          String?
  company           Company @relation(fields: [companyId], references: [id])
  shop              Shop    @relation(fields: [shopId], references: [id])

  @@unique([shopifyCustomerId, shopId])
}

model Catalog {
  id                   Int              @id @default(autoincrement())
  shopId               Int
  companyId            Int
  companyLocationId    Int?
  priceListId          Int?
  shopifyId            String
  title                String
  status               String
  publicationShopifyId String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyLocation      CompanyLocation? @relation(fields: [companyLocationId], references: [id])
  priceList            PriceList?       @relation(fields: [priceListId], references: [id])
  shop                 Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  publications         Publication[]

  @@unique([shopifyId, shopId])
  @@index([shopId])
  @@index([companyId])
  @@index([companyLocationId])
  @@index([priceListId])
}

model PriceList {
  id              Int       @id @default(autoincrement())
  shopId          Int
  shopifyId       String
  name            String
  currency        String
  adjustmentType  String?
  adjustmentValue Decimal?  @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  catalogs        Catalog[]
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopifyId, shopId])
  @@index([shopId])
  @@map("price_lists")
}

model Publication {
  id           Int                  @id @default(autoincrement())
  shopId       Int
  catalogId    Int?
  shopifyId    String
  title        String?
  defaultState String
  autoPublish  Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  products     PublicationProduct[]
  catalog      Catalog?             @relation(fields: [catalogId], references: [id])
  shop         Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopifyId, shopId])
  @@index([shopId])
  @@index([catalogId])
  @@map("publications")
}

model PublicationProduct {
  id            Int         @id @default(autoincrement())
  publicationId Int
  productId     String
  createdAt     DateTime    @default(now())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, productId])
  @@index([publicationId])
  @@index([productId])
  @@map("publication_products")
}

model Order {
  id          Int               @id @default(autoincrement())
  shopId      Int
  shopifyId   String
  companyId   Int?
  orderNumber String?
  totalPrice  Decimal?          @db.Decimal(10, 2)
  currency    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  collections OrderCollection[]
  orderItems  OrderItem[]
  company     Company?          @relation(fields: [companyId], references: [id])
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopifyId, shopId])
  @@index([shopId])
  @@index([companyId])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  variantId Int
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Collection {
  id          Int                  @id @default(autoincrement())
  shopId      Int
  title       String
  description String?
  status      String               @default("ACTIVE")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  discount    Decimal              @default(0) @db.Decimal(5, 2)
  customers   CollectionCustomer[]
  products    CollectionProduct[]
  shop        Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders      OrderCollection[]

  @@index([shopId])
  @@map("collections")
}

model OrderCollection {
  id           Int        @id @default(autoincrement())
  orderId      Int
  collectionId Int
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, collectionId])
  @@index([orderId])
  @@index([collectionId])
  @@map("order_collections")
}

model Customer {
  id                Int                  @id @default(autoincrement())
  shopId            Int
  shopifyCustomerId String
  shopifyNumericId  String?
  email             String?
  firstName         String?
  lastName          String?
  phone             String?
  state             String?
  tags              String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  collections       CollectionCustomer[]
  shop              Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopifyCustomerId, shopId])
  @@index([shopId])
  @@index([shopifyNumericId])
  @@index([email])
  @@map("customers")
}

model CollectionCustomer {
  id                Int        @id @default(autoincrement())
  shopId            Int
  shopifyCustomerId String
  collectionId      Int
  customerId        Int
  email             String?
  firstName         String?
  lastName          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  collection        Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shop              Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([collectionId, shopifyCustomerId])
  @@unique([collectionId, customerId])
  @@index([shopId])
  @@index([collectionId])
  @@index([customerId])
  @@index([shopifyCustomerId])
  @@map("collection_customers")
}

model CollectionProduct {
  id              Int        @id @default(autoincrement())
  collectionId    Int
  productId       String
  variantId       String
  originalPrice   Decimal    @db.Decimal(10, 2)
  discountedPrice Decimal    @db.Decimal(10, 2)
  currency        String     @default("USD")
  sku             String?
  productTitle    String
  variantTitle    String?
  createdAt       DateTime   @default(now())
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, variantId])
  @@index([collectionId])
  @@index([productId])
  @@map("collection_products")
}

model Subscription {
  id                    Int       @id @default(autoincrement())
  shopifyUrl            String    @unique @map("shopify_url")
  shopifySubscriptionId String?   @map("shopify_subscription_id")
  chargeId              String?   @map("charge_id")
  planId                String    @map("plan_id")
  planName              String    @map("plan_name")
  planPrice             Float     @map("plan_price")
  maxCatalogs           Int       @map("max_catalogs")
  maxCompanies          Int       @map("max_companies")
  maxOrders             Int       @map("max_orders")
  features              String?
  isActive              Boolean   @default(false) @map("is_active")
  startedAt             DateTime  @default(now()) @map("started_at")
  expiresAt             DateTime? @map("expires_at")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("subscriptions")
}
